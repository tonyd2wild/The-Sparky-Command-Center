{
  "_comment": "Copy to config.json (gitignored) and edit for YOUR fleet. Every field is documented in README.md. Keys starting with _ are ignored. Hosts below are examples: nothing here points at a real machine.",
  "server": {
    "title": "My Command Center",
    "subtitle": "Home lab AI fleet",
    "location": "",
    "timezone": "America/New_York",
    "bind": ["127.0.0.1"],
    "port": 8895,
    "allowed_hosts": [],
    "read_only": true,
    "browser_refresh_ms": 2500
  },
  "ssh": {
    "default_key": "~/.ssh/id_ed25519",
    "connect_timeout": 8,
    "options": {"IdentitiesOnly": "yes", "BatchMode": "yes", "StrictHostKeyChecking": "accept-new"}
  },
  "defaults": {"poll_interval": 7.0, "model_poll_interval": 6.0, "temp_warn": 70, "temp_hot": 84, "stale_after_s": 20, "mem_warn_gib": 8, "mem_crit_gib": 4},
  "nodes": [
    {"key": "spark1", "name": "Spark 1", "profile": "unified", "node_id": "spark-0001", "rank": 0,
     "user": "me", "host": "spark1.example.lan",
     "serving": "my-model", "pair": "my-model TP=2 · head :8000"},
    {"key": "spark2", "name": "Spark 2", "profile": "unified", "node_id": "spark-0002", "rank": 1,
     "user": "me", "host": "spark2.lan.internal",
     "jump": {"user": "me", "host": "spark1.example.lan", "mode": "proxy"},
     "serving": "my-model", "pair": "my-model TP=2 · rank 1"},
    {"key": "gpu-box", "name": "gpu-box", "profile": "discrete", "badge": "UBUNTU · BOX",
     "user": "me", "host": "gpu-box.example.lan", "ssh_key": "~/.ssh/id_ed25519",
     "list_containers": true,
     "containers": {"vllm-main": {"label": "My 32B model", "port": 8010, "gpus": "GPU 0+1"}}}
  ],
  "sections": [
    {"key": "cluster", "eyebrow": "Spark cluster", "title": "Spark cluster", "subtitle": "2x unified-memory nodes",
     "nodes": ["spark1", "spark2"], "switch": true, "units": ["cluster"], "models_title": "Model performance"},
    {"key": "box", "eyebrow": "GPU box", "title": "gpu-box", "subtitle": "discrete GPUs",
     "nodes": ["gpu-box"], "units": ["box"], "models_title": "Model performance"}
  ],
  "switch": {
    "enabled": true,
    "name": "Fabric switch", "badge": "RoCE FABRIC",
    "host": "switch.example.lan", "user": "admin", "ssh_key": "~/.ssh/id_ed25519",
    "_exec_example": {"argv": ["expect", "my-switch-helper.exp", "{cmd}"], "cwd": "/path/to/helper"},
    "ports": ["qsfp28-1-1", "qsfp28-1-2"],
    "poll_interval": 8.0, "temp_warn": 55, "temp_hot": 70
  },
  "models": [
    {"key": "main-model", "label": "my-model · TP=2", "unit": "cluster", "node": "spark1",
     "endpoint": "http://spark1.example.lan:8000", "port": 8000, "gpus": "Spark 1 + Spark 2", "model": "my-model"},
    {"key": "box-32b", "label": "My 32B model", "unit": "box", "node": "gpu-box",
     "endpoint": "http://gpu-box.example.lan:8010", "port": 8010, "gpus": "GPU 0+1"}
  ],
  "comfy_title": "Render lanes · ComfyUI",
  "comfy_lanes": [
    {"key": "lane-a", "lane": "A", "name": "gpu-box · GPU 2", "host": "gpu-box", "url": "http://gpu-box.example.lan:8188",
     "src": {"kind": "gpu", "node": "gpu-box", "index": 2}}
  ],
  "tokens": {"enabled": true, "mode": "bank", "store": "data/token_usage.json", "poll_seconds": 120, "order": []},
  "eco": {
    "enabled": false,
    "allow_writes": false,
    "info_url": "",
    "levels": [
      {"value": "2200", "arg": "0,2200", "label": "ECO 2200", "default": true},
      {"value": "off", "label": "OFF (full clocks)"}
    ]
  },
  "stations": {
    "enabled": false,
    "items": [
      {"emoji": "📝", "name": "My web app", "desc": "anything else on this host", "port": 3000,
       "url": "http://myhost.example.lan:3000/", "probe_url": "http://127.0.0.1:3000/"}
    ]
  },
  "keylights": {"enabled": false, "url": "", "allow_writes": false},
  "chat": {
    "enabled": true,
    "name": "Jarvis",
    "base_url": "",
    "model": "",
    "api_key": "",
    "temperature": 0.1,
    "max_tokens": 1200,
    "timeout": 180,
    "grounding": true,
    "extra_body": {},
    "fallbacks": [],
    "system_prompt": "",
    "suggestions": ["What is down right now?", "Which node is running hottest?", "How fast is each model decoding?"]
  }
}
